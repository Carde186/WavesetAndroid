# Configurazione server
PORT=3000

# Configurazione database MySQL
# In locale con Docker Compose, DB_HOST deve restare "mysql" (nome del servizio
# nel docker-compose.yml) cosi' il container backend riesce a raggiungere il
# container del database.
DB_HOST=mysql
DB_PORT=3306
DB_USER=waveset
DB_PASSWORD=waveset
DB_NAME=waveset
