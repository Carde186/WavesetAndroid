# Configurazione server
PORT=3000

# Configurazione database MySQL
# In locale con Docker Compose, DB_HOST deve restare "mysql" (nome del servizio
# nel docker-compose.yml) cosi' il container backend riesce a raggiungere il
# container del database.
DB_HOST=mysql
DB_PORT=3306
DB_USER=waveset
DB_PASSWORD=waveset
DB_NAME=waveset

# Import eventi Ticketmaster (avvio manuale, vedi README):
#   node scripts/importaTicketmaster.js
# Ticketmaster Developer Portal: self-service, gratuita.
TICKETMASTER_API_KEY=

# Fallback di geocodifica quando Ticketmaster non fornisce coordinate valide.
# Stesso progetto Google Cloud già usato per Maps, ma chiave SEPARATA,
# ristretta alla sola "Geocoding API" (vedi README) - non la stessa
# GOOGLE_MAPS_API_KEY usata da Gradle nel .env della root.
GOOGLE_GEOCODING_API_KEY=

# Client Credentials Flow (Spotify for Developers, app in Development Mode:
# richiede che il proprietario dell'app abbia un abbonamento Premium attivo).
# Usate oggi solo dall'anteprima ADMIN di sola lettura (GET
# /api/admin/spotify/anteprima) — non c'è ancora un seed del catalogo da
# Spotify, vedi CLAUDE.md. Senza queste chiavi l'anteprima risponde 503, il
# resto dell'app funziona comunque.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
